{
  "name": "openclaw-matrix-call-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:artifacts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.27.4",
    "openclaw": "2026.10.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
