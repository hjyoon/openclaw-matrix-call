{
  "name": "openclaw-matrix-call-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs",
    "verify:browser-sandbox": "node scripts/verify-browser-sandbox.mjs",
    "verify:browser-container": "MATRIX_CALL_BROWSER_IMAGE=matrix-call-browser-worker:0.1.0-alpha.1 node scripts/verify-matrix.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers playwright-core install chromium",
    "schema:sync": "pnpm build && node scripts/sync-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:artifacts && pnpm verify:worker && pnpm verify:plugin"
  },
  "devDependencies": {
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.27.4",
    "livekit-client": "2.22.4",
    "matrix-js-sdk": "43.0.0",
    "openclaw": "2026.10.2",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
