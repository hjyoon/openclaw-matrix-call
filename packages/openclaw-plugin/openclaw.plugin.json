{
  "id": "matrix-call",
  "name": "Matrix Call",
  "version": "0.1.0-alpha.1",
  "description": "Experimental Matrix call adapters; native call wiring is unavailable",
  "channels": [
    "matrix-call"
  ],
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "channelConfigs": {
    "matrix-call": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "readOnly": true,
        "type": "object",
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "policy": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "owners": {
                "readOnly": true,
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^@[^:\\s]+:[^\\s]+$"
                }
              },
              "rooms": {
                "readOnly": true,
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 255,
                  "pattern": "^![^\\s]+$"
                }
              },
              "agents": {
                "readOnly": true,
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                }
              }
            },
            "required": [
              "owners",
              "rooms",
              "agents"
            ],
            "additionalProperties": false
          },
          "agentService": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "secretFile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "host": {
                "default": "127.0.0.1",
                "type": "string",
                "enum": [
                  "127.0.0.1",
                  "::1"
                ]
              },
              "port": {
                "default": 19793,
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "timeoutMs": {
                "default": 30000,
                "type": "integer",
                "minimum": 1,
                "maximum": 300000
              }
            },
            "required": [
              "secretFile"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "policy"
              ]
            }
          }
        ]
      },
      "label": "Matrix Call",
      "description": "Experimental Matrix calling policy; native call wiring is unavailable",
      "commands": {
        "nativeCommandsAutoEnabled": false,
        "nativeSkillsAutoEnabled": false
      }
    }
  }
}
